from kivy.app import App
from kivy.uix.label import Label
from kivy.core.window import Window

class StudyPlannerApp(App):
    def build(self):
        Window.clearcolor = (0.02, 0.04, 0.12, 1)
        return Label(
            text="NEON STUDY PLANNER\n\nYour Study Journey Starts Here!",
            font_size="24sp",
            color=(0, 0.85, 1, 1),
            halign="center"
        )

StudyPlannerApp().run()
